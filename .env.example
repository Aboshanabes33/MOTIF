# Motif never reads an AI API key from the server environment, and it must not: each signed-in
# browser links its own provider account from the in-app dialog, and credentials are stored in the
# encrypted server-side vault (.motif/connections.enc by default).
#
# Required in production to keep the signed browser principal cookie and the local encrypted vault
# from being trusted across restarts:
# MOTIF_SESSION_SECRET="generate a random string of at least 32 characters"
# (optionally, to keep encryption independent of the session secret)
# MOTIF_CREDENTIALS_KEY="base64-encoded 32-byte key"
#
# Absolute or relative path for the encrypted vault file. Defaults to ./.motif/connections.enc.
# MOTIF_SECRETS_FILE=".motif/connections.enc"
#
# Absolute origin used for server-side OAuth callbacks, e.g. "https://motif.example.com".
# Required only for the OpenRouter OAuth callback to build a public callback URL.
# In development only, falls back to the incoming request origin when unset.
MOTIF_PUBLIC_BASE_URL="http://localhost:3000"
#
# Never put any of these values in a variable with a VITE_ prefix: those ship to the browser.
# Optional server-only Sentry DSN for classified provider failures. No request/body capture.
# MOTIF_SENTRY_DSN=""

VITE_POSTHOG_KEY=your_posthog_project_token
VITE_POSTHOG_HOST=https://your-posthog-host

# Auth (WorkOS AuthKit + Convex). Leave unset to run the app without sign-in.
VITE_WORKOS_CLIENT_ID=client_...
VITE_CONVEX_URL=https://your-deployment.convex.cloud
# Set WORKOS_CLIENT_ID in the Convex deployment environment too (see convex/auth.config.ts).

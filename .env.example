VITE_POSTHOG_KEY=your_posthog_project_token
VITE_POSTHOG_HOST=https://your-posthog-host

# Auth (WorkOS AuthKit + Convex). Leave unset to run the app without sign-in.
VITE_WORKOS_CLIENT_ID=client_...
VITE_CONVEX_URL=https://your-deployment.convex.cloud
# Set WORKOS_CLIENT_ID in the Convex deployment environment too (see convex/auth.config.ts).
# Whop sandbox checkout links for the paid plans (optional; without them paid plans show "Coming soon")
VITE_WHOP_CHECKOUT_MONTHLY=
VITE_WHOP_CHECKOUT_YEARLY=
# Convex deployment env (not build-time): WORKOS_CLIENT_ID, WORKOS_API_KEY (account deletion),
# WHOP_WEBHOOK_SECRET, WHOP_PLAN_ID_MONTHLY, WHOP_PLAN_ID_YEARLY. Webhook URL: <convex site url>/whop

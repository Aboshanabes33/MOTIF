{
  "appId": "local.motif.desktop",
  "productName": "MOTIF",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "package.json",
    "THIRD-PARTY-NOTICES.txt",
    "build/icon.png",
    "build/icon.ico",
    "!**/.env",
    "!**/.env.*"
  ],
  "asar": true,
  "npmRebuild": false,
  "win": {
    "target": [
      "portable"
    ],
    "signAndEditExecutable": true,
    "artifactName": "MOTIF-${version}-${arch}.${ext}",
    "icon": "build/icon.ico",
    "signExecutable": false
  },
  "portable": {
    "requestExecutionLevel": "user"
  },
  "compression": "normal",
  "nsis": {
    "installerIcon": "build/icon.ico",
    "uninstallerIcon": "build/icon.ico",
    "installerHeaderIcon": "build/icon.ico"
  }
}

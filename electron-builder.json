{
  "appId": "local.motif.desktop",
  "productName": "MOTIF",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "package.json",
    "THIRD-PARTY-NOTICES.txt"
  ],
  "asar": true,
  "npmRebuild": false,
  "win": {
    "target": [
      "portable"
    ],
    "signAndEditExecutable": false,
    "artifactName": "MOTIF-${version}-${arch}.${ext}"
  },
  "portable": {
    "requestExecutionLevel": "user"
  },
  "compression": "normal"
}

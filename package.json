{
  "name": "motif-desktop",
  "productName": "MOTIF",
  "version": "2.1.1",
  "description": "MOTIF — Liquid Glass Creative Desktop App with Brand Identity Hub and MCP Agent Integration",
  "type": "module",
  "main": "electron/main.mjs",
  "homepage": "https://github.com/Aboshanabes33/MOTIF",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aboshanabes33/MOTIF.git"
  },
  "author": "MOTIF",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "dev:server": "node server/motif-server.mjs",
    "dev:full": "node scripts/dev-full.mjs",
    "build": "tsc -b && vite build",
    "build:web": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "start:server": "node server/motif-server.mjs",
    "mcp": "node mcp/motif-mcp.mjs",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:start": "electron .",
    "dist:win": "npm run build && electron-builder --win nsis portable --x64",
    "dist:win:dir": "npm run build && electron-builder --win --x64 --dir",
    "build:win-exe": "npm run build && python3 scripts/build-win-exe.py",
    "test": "node --test tests/*.test.mjs",
    "video:status": "node -e \"import('./server/video-agent.mjs').then(m=>console.log(JSON.stringify(m.editingStatus(),null,2)))\"",
    "video:plan": "node -e \"import('./server/video-agent.mjs').then(m=>console.log(JSON.stringify(m.clipPlan({name:process.argv[1]||'clip',mode:process.argv[2]||'full'}),null,2)))\"",
    "typecheck": "tsc --noEmit",
    "icons": "python3 scripts/generate-icons.py"
  },
  "dependencies": {
    "@hyperframes/player": "^0.9.102",
    "@opentelemetry/exporter-logs-otlp-http": "^0.301.2",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-logs": "^3.1.1",
    "@remotion/player": "^4.0.547",
    "@sentry/node": "^11.19.0",
    "@sentry/react": "^11.19.0",
    "@workos-inc/authkit-react": "^0.16.3",
    "convex": "^1.51.0",
    "gsap": "^3.15.1",
    "lucide-react": "^0.511.0",
    "posthog-js": "^1.455.4",
    "posthog-node": "^6.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "remotion": "^4.0.547"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^35.2.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}

{
  "name": "motif-desktop",
  "productName": "MOTIF",
  "version": "2.0.0",
  "description": "MOTIF — Liquid Glass Creative Studio Desktop App with Brand Identity Hub and MCP Agent Integration",
  "type": "module",
  "main": "electron/main.mjs",
  "homepage": "https://github.com/Aboshanabes33/MOTIF",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aboshanabes33/MOTIF.git"
  },
  "author": "MOTIF",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "dev:server": "node server/motif-server.mjs",
    "dev:full": "node scripts/dev-full.mjs",
    "build": "tsc -b && vite build",
    "build:web": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "start:server": "node server/motif-server.mjs",
    "mcp": "node mcp/motif-mcp.mjs",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:start": "electron .",
    "dist:win": "npm run build && electron-builder --win nsis portable --x64",
    "dist:win:dir": "npm run build && electron-builder --win --x64 --dir",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "icons": "python3 scripts/generate-icons.py"
  },
  "dependencies": {
    "@sentry/electron": "^8.5.0",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^35.2.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}

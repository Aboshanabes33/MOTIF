{
  "name": "motif-phase0",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build && esbuild src/preload.ts --bundle --platform=node --external:electron --format=cjs --outfile=dist-electron/preload.cjs",
    "check": "tsc --noEmit && tsc -p tsconfig.renderer.json",
    "test": "tsx --test test/*.test.ts",
    "start": "electron .",
    "probe": "tsx scripts/probe.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "express": "5.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.5",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "electron": "45.5.0",
    "esbuild": "0.27.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  },
  "main": "dist-electron/main.js"
}
